rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.lastSurah is int && data.lastSurah >= 1 && data.lastSurah <= 114 &&
             data.lastAyah is int && data.lastAyah >= 1 && data.lastAyah <= 286 &&
             data.lastPage is int && data.lastPage >= 1 && data.lastPage <= 604 &&
             data.khatmahCount is int && data.khatmahCount >= 0 && data.khatmahCount <= 100000 &&
             data.tasbeehTotal is int && data.tasbeehTotal >= 0 && data.tasbeehTotal <= 100000000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidBookmark(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.surahNumber is int && data.surahNumber >= 1 && data.surahNumber <= 114 &&
             data.ayahNumber is int && data.ayahNumber >= 1 && data.ayahNumber <= 286 &&
             data.pageNumber is int && data.pageNumber >= 1 && data.pageNumber <= 604 &&
             data.label is string && data.label.size() >= 1 && data.label.size() <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMemorizationPlan(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.surahNumber is int && data.surahNumber >= 1 && data.surahNumber <= 114 &&
             data.surahName is string && data.surahName.size() >= 1 && data.surahName.size() <= 80 &&
             data.dailyAyahTarget is int && data.dailyAyahTarget >= 1 && data.dailyAyahTarget <= 286 &&
             data.completedAyahs is int && data.completedAyahs >= 0 && data.completedAyahs <= data.totalAyahs &&
             data.totalAyahs is int && data.totalAyahs >= 1 && data.totalAyahs <= 286 &&
             data.status is string && data.status in ['ACTIVE', 'COMPLETED'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/profile/{docId} {
      allow get: if isOwner(userId) && isValidId(docId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(docId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'lastSurah', 'lastAyah', 'lastPage', 'khatmahCount', 'tasbeehTotal', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'lastSurah', 'lastAyah', 'lastPage', 'khatmahCount', 'tasbeehTotal', 'createdAt', 'updatedAt']) &&
                       isValidProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(docId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidProfile(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'lastSurah', 'lastAyah', 'lastPage', 'khatmahCount', 'tasbeehTotal', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(docId);
    }

    match /users/{userId}/bookmarks/{bookmarkId} {
      allow get: if isOwner(userId) && isValidId(bookmarkId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(bookmarkId) &&
                       incoming().keys().hasAll(['userId', 'surahNumber', 'ayahNumber', 'pageNumber', 'label', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'surahNumber', 'ayahNumber', 'pageNumber', 'label', 'createdAt', 'updatedAt']) &&
                       isValidBookmark(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(bookmarkId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidBookmark(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['surahNumber', 'ayahNumber', 'pageNumber', 'label', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(bookmarkId);
    }

    match /users/{userId}/memorization_plans/{planId} {
      allow get: if isOwner(userId) && isValidId(planId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(planId) &&
                       incoming().keys().hasAll(['userId', 'surahNumber', 'surahName', 'dailyAyahTarget', 'completedAyahs', 'totalAyahs', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'surahNumber', 'surahName', 'dailyAyahTarget', 'completedAyahs', 'totalAyahs', 'status', 'createdAt', 'updatedAt']) &&
                       isValidMemorizationPlan(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(planId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       existing().status != 'COMPLETED' &&
                       isValidMemorizationPlan(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['dailyAyahTarget', 'completedAyahs', 'status', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(planId);
    }
  }
}
